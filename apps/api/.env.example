# Copy to .env on the server. Never commit the real one.

# Public hostname Caddy gets a certificate for, e.g. api.example.com
# (no domain yet? use <ip-with-dashes>.sslip.io, e.g. 157-180-74-100.sslip.io)
DOMAIN=

# Signs session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# iOS OAuth client id from Google Cloud (enables POST /auth with provider "google")
GOOGLE_CLIENT_ID=

# Bundle id of the iOS app (Sign in with Apple audience, push topic, universal links).
BUNDLE_ID=app.doodle.ios

# Apple Team ID (developer.apple.com > Membership). Turns on: Sign in with Apple
# (provider "apple"), universal links for invite links, and push notifications.
APPLE_TEAM_ID=

# Push notifications (APNs). Create a key at developer.apple.com > Keys (enable APNs), download
# the .p8 once, copy it to /opt/doodle-secrets/ on the server. KEY_ID is the 10-char id shown there.
APNS_KEY_ID=
APNS_KEY_PATH=/secrets/AuthKey.p8

# Invite links (https://<DOMAIN>/i/<code>).
# Shown as the "Get the app" button on the invite page.
APP_STORE_URL=

# Temporary test login, before Google is set up. Sign in with provider "dev" and
# token "<this value>:<any name>". Remove once Google sign-in works.
# Generate with: openssl rand -hex 12
DEV_AUTH_KEY=
